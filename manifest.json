{
  "manifest_version": 3,
  "name": "SheetSpeed - Luyện Đọc Sheet Nhạc 5s",
  "version": "1.0.0",
  "description": "Luyện phản xạ đọc nốt nhạc Khóa Sol & Khóa Fa dạng chuỗi nốt mỗi 5 giây với Chế độ nhẹ nhàng (Gentle Mode).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SheetSpeed - Luyện Đọc Sheet Nhạc",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/vexflow.min.js",
        "src/engine/music-engine.js",
        "src/engine/audio-synth.js",
        "src/engine/midi-controller.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/vexflow.min.js",
        "lib/fonts/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
